type Problem{
    id:ID
    platformName: String
    questionName: String
    questionId: Int
    difficulty: String
    link: String
    intuition: String
    keyIdea: String
    approach: String
    mistakes: String
    code: String
    timeComplexity: String
    spaceComplexity: String
}

type User{
    id: ID!
    userName: String!
    email: String!
    password: String!
    createdAt: String
}

type AuthResponse {
    token: String
}
type Query {
    getAllProblems: [Problem]
    getLeetcode: [Problem]
    getCodechef: [Problem]
    getCSES: [Problem]
    getCodeforces: [Problem]
    getByquestionName(questionName: String!): [Problem]
    searchProblems(questionName: String, platformName: String): [Problem]
}

type Mutation{
    addProblem(
        platformName: String
        questionName: String
        questionId: Int
        difficulty: String
        link: String
        intuition: String
        keyIdea: String
        approach: String
        mistakes: String
        code: String
        timeComplexity: String
        spaceComplexity: String
    ): Problem
}

extend type Mutation {
    addUser(
        userName: String!
        email: String!
        password: String!
    ): User
    
    login(
        email: String!
        password: String!
    ): AuthResponse
}